# REQUIRED in production: public base URL of the backend-v2 API
# (e.g. https://api.farmilky.example.com). If unset, the app falls back to
# http://localhost:4000 (local dev default) and logs an error in prod builds.
VITE_API_BASE_URL=http://localhost:4000
# Tenant slug sent on every login request. Change this if you deploy for a different tenant.
VITE_TENANT_SLUG=farmilky
