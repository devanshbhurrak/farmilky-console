{
    "name": "farmilky-management-v2",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "build:skip-typecheck": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "typecheck": "tsc -b --force",
        "deploy": "wrangler deploy",
        "deploy:dry": "npm run build && wrangler deploy --dry-run --outdir .wrangler-dist",
        "predeploy": "npm run build"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "@tanstack/react-query": "^5.104.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "lucide-react": "^0.544.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.65.0",
        "react-router-dom": "^7.9.4",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "@vitejs/plugin-react": "^5.0.4",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3",
        "vite": "^8.3.3",
        "wrangler": "^4.154.0"
    }
}