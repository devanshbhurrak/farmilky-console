# Production environment for farmilky-management-v2
# Vite inlines these values at build time (vite build mode=production).
# Deploy with: npm run build && wrangler deploy

# Public base URL of the backend-v2 API (Cloudflare Workers deployment).
# Must match the backend's public hostname. The SPA is served by the same
# Worker that proxies /api/* to the backend via a service binding, so
# requests are same-origin and no CORS is required.
VITE_API_BASE_URL=https://farmilky-engine.farmilky.workers.dev

# Tenant slug sent on every login request.
VITE_TENANT_SLUG=farmilky
